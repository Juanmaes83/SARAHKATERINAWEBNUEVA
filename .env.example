# ---------------------------------------------------------------------------
# Sarah Katerina — new website
#
# ABSOLUTE RULE: never commit a real .env file, an API key, a token, a CRM
# credential or an analytics ID to this repository. This file documents the
# ONLY variables the application is allowed to read. All of them are public
# (NEXT_PUBLIC_*) and none of them is a secret.
# ---------------------------------------------------------------------------

# preview | production
# Governs copy/behaviour that must differ between an internal preview and an
# approved public site. Defaults to "preview".
NEXT_PUBLIC_SITE_MODE=preview

# true | false
# Master indexing switch. MUST stay false until a human approves publication.
# Defaults to false when unset or malformed.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Absolute origin used to build canonical URLs, Open Graph URLs and sitemap
# entries.
#
# PENDING_APPROVAL — the production host is an OPEN decision in the source of
# truth. decisions-log.md (2026-08-05) approved https://sarahkaterina.com
# (non-www), but the 2026-09-16 verification recorded production redirecting
# non-www -> www and left the conflict "Abierta" as a P0.
#
# Do NOT set this to a sarahkaterina.com host until that conflict is resolved
# by Sarah/business. For previews, set it to the Vercel preview URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the deployed Sarah Katerina Buyer System.
#
# The upstream production origin was verified on 2026-09-28. Configure it only
# in the controlled Vercel Preview environment. Keep it unset in Production;
# when unset, Buyer Tool entry points remain pending.
#
# Public, never a secret: this is an outbound-link origin, not a credential.
# Do not add API keys, tokens or other secrets here.
#
# See docs/buyer-system-integration.md (B-01).
NEXT_PUBLIC_BUYER_SYSTEM_URL=

# Contact channels (docs/contact-page.md). Public, never secrets.
#
# Both carry the brand's production domain, and the canonical production host
# is an OPEN decision, so they are configuration rather than code. While a
# value is unset, that channel is not rendered on /preview/contact.
#
# NEXT_PUBLIC_BOOKING_URL — the live booking calendar (verified read-only
# 2026-09-29: 30-minute slots, Europe/Madrid, Google Calendar invite). HTTPS,
# no query string. See docs/contact-page.md §2 for the verified value.
NEXT_PUBLIC_BOOKING_URL=
#
# NEXT_PUBLIC_CONTACT_EMAIL — the published contact address (live site,
# 2026-09-29). See docs/contact-page.md §3.
NEXT_PUBLIC_CONTACT_EMAIL=
